{
    "name": "resilience-kit/laravel-resilience-kit",
    "description": "Pacote Laravel modular de resiliência: Circuit Breaker atômico (Redis/Cache), fallbacks e dashboard de monitoramento.",
    "keywords": [
        "laravel",
        "resilience",
        "circuit-breaker",
        "fault-tolerance",
        "redis",
        "sail"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/redis": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.38",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelResilienceKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelResilienceKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "format:check": "vendor/bin/pint --test",
        "check": [
            "@format:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelResilienceKit\\ResilienceServiceProvider"
            ],
            "aliases": {
                "Resilience": "LaravelResilienceKit\\Facades\\Resilience"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

# Laravel Sail (docker-compose.yml)
WWWUSER=1000
WWWGROUP=1000
FORWARD_REDIS_PORT=6379
SAIL_XDEBUG_MODE=off

# Laravel Resilience Kit
RESILIENCE_DRIVER=redis
RESILIENCE_CB_FAILURE_THRESHOLD=5
RESILIENCE_CB_RECOVERY_TIMEOUT=30
RESILIENCE_CB_HALF_OPEN_TRIALS=3
RESILIENCE_CB_CACHE_STORE=redis
RESILIENCE_CB_REDIS_CONNECTION=default
RESILIENCE_DASHBOARD_ENABLED=true
RESILIENCE_DASHBOARD_PATH=resilience/dashboard
RESILIENCE_DASHBOARD_API_PATH=resilience/api
